# SiteRevamp 后端环境变量。复制本文件为 backend/.env 后填写真实值；不要提交 backend/.env。
#
# Supabase Dashboard -> Connect -> ORMs -> SQLAlchemy：复制其中的 URI。
# 对 Vercel 等 Serverless 部署，优先使用 Transaction pooler（端口 6543）且保留 sslmode=require。
# 当前依赖使用 psycopg2，因此 URL 协议应为 postgresql+psycopg2://。
SITE_REVAMP_SQLALCHEMY_DATABASE_URL="postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# 生成一个长度至少 32 的随机字符串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SITE_REVAMP_JWT_SECRET_KEY="replace-with-a-long-random-secret"

# 你的兼容 OpenAI 的 API 服务配置。
SITE_REVAMP_OPENAI_API_KEY="replace-with-your-api-key"
SITE_REVAMP_OPENAI_BASE_URL="https://api.openlux.ai/v1"
# 当前 AI 服务渠道已确认可用的模型；可按服务商模型列表替换，无需修改代码。
SITE_REVAMP_AI_MODEL="gemini-4-argon"

# 多个来源用英文逗号分隔。生产同域部署可填写实际域名，避免使用 *。
SITE_REVAMP_CORS_ORIGINS="http://localhost:3000,https://your-site.vercel.app"
