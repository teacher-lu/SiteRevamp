{
  "functions": {
    "api/index.py": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    { "src": "backend/main.py", "use": "@vercel/python" }
  ]
}
